+/*
+ * BENCH PROBE ONLY -- not for merging. Qualcomm carries FM over the BT UART
+ * as H4 packet type 0x11 (command: opcode le16, len, params) and 0x14
+ * (event: code, len, params). Log any FM event so a probe can tell whether
+ * the controller has an FM block at all.
+ */
+#define QCA_FM_EVENT_PKT	0x14
+
+static int qca_recv_fm_event(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	bt_dev_info(hdev, "FM event (%u bytes)", skb->len);
+	print_hex_dump(KERN_INFO, "qca fm evt: ", DUMP_PREFIX_OFFSET, 16, 1,
+		       skb->data, skb->len, false);
+	kfree_skb(skb);
+	return 0;
+}
+
+#define QCA_FM_EVENT \
+	.type = QCA_FM_EVENT_PKT, \
+	.hlen = 2, \
+	.loff = 1, \
+	.lsize = 1, \
+	.maxlen = HCI_MAX_EVENT_SIZE
+
 static const struct h4_recv_pkt qca_recv_pkts[] = {
+	{ QCA_FM_EVENT,            .recv = qca_recv_fm_event },
 	{ H4_RECV_ACL,             .recv = qca_recv_acl_data },
 	{ H4_RECV_SCO,             .recv = hci_recv_frame    },
 	{ H4_RECV_EVENT,           .recv = qca_recv_event    },
