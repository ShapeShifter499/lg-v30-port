+/* BENCH PROBE ONLY: Qualcomm FM command packets on the BT UART */
+#define QCA_FM_CMD_PKT		0x11
+
+static int qca_enqueue(struct hci_uart *hu, struct sk_buff *skb);
+
+static ssize_t qca_fm_cmd_write(struct file *file, const char __user *ubuf,
+				size_t count, loff_t *ppos)
+{
+	struct hci_dev *hdev = file->private_data;
+	struct hci_uart *hu = hci_get_drvdata(hdev);
+	char buf[256], *p, *tok;
+	u8 bytes[64];
+	int n = 0, ret;
+	struct sk_buff *skb;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = 0;
+
+	p = buf;
+	while ((tok = strsep(&p, " \t\n")) && n < ARRAY_SIZE(bytes)) {
+		if (!*tok)
+			continue;
+		ret = kstrtou8(tok, 16, &bytes[n]);
+		if (ret)
+			return ret;
+		n++;
+	}
+	if (n < 3)
+		return -EINVAL;
+
+	skb = bt_skb_alloc(n, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+	skb_put_data(skb, bytes, n);
+	hci_skb_pkt_type(skb) = QCA_FM_CMD_PKT;
+	bt_dev_info(hdev, "sending FM command, %d bytes", n);
+	qca_enqueue(hu, skb);
+	hci_uart_tx_wakeup(hu);
+
+	return count;
+}
+
+static const struct file_operations qca_fm_cmd_fops = {
+	.open = simple_open,
+	.write = qca_fm_cmd_write,
+};
+
