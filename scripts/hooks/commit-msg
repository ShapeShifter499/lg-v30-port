#!/usr/bin/env bash
# commit-msg hook: every commit in a shared repo must say who made it.
#
# Three agents (Ember/Claude Code, Aurel/Hermes, Nymble/OpenClaw) and one
# human all commit on this box as the same git identity,
# Lance <Gero3977@gmail.com>. That is deliberate -- kernel.org policy puts
# the human in Signed-off-by -- but it means git's own author/committer
# fields cannot tell us who did anything. The Assisted-by trailer is the
# only discriminator, and nothing enforced it.
#
# On 2026-08-07 two commits appeared in linux-mainline-v30 at 22:25:18
# reverting the WCN3990 Wi-Fi/BT enable. Stock `git revert` message, no
# trailers, orphaned on no branch. A day of forensics -- reflog, journal,
# shell history, session logs, cron manifests -- could rule out several
# actors but could not name one, purely because nothing recorded it. This
# hook exists so that never costs a day again.
#
# It rejects commits missing either required trailer:
#
#     Signed-off-by: <human>
#     Assisted-by: AGENT_NAME:MODEL_VERSION [tool ...]
#
# Two of those rules come straight from
# https://docs.kernel.org/process/coding-assistants.html:
#
#   - "AI agents MUST NOT add Signed-off-by tags." Only the human can
#     certify the DCO.
#   - Assisted-by is spelled AGENT_NAME:MODEL_VERSION, optionally
#     followed by specialised analysis tools (coccinelle, sparse,
#     smatch, clang-tidy). Basic tooling -- git, gcc, make, editors --
#     is not listed. Upstream's own example is
#         Assisted-by: Claude:claude-3-opus coccinelle sparse
#
# One rule is deliberately STRICTER than upstream. kernel.org requires
# Assisted-by only when an assistant was actually used; a purely human
# commit simply omits it. Here it is required on every commit, because
# the whole point is telling four committers apart when they all share
# one git identity, and "no trailer" is indistinguishable from "agent
# that forgot". Unaided human commits use:
#
#     Assisted-by: none
#
# That is a local convention, not a kernel.org one. Strip it when
# exporting a patch upstream.
#
# Merges and reverts-in-progress are exempt: their messages are generated
# by git before a human or agent can annotate them, and the follow-up
# commit carries the attribution.
#
# Install with scripts/install-git-hooks.sh. Bypass in a genuine
# emergency with `git commit --no-verify`, but understand that doing so
# reintroduces exactly the blind spot this closes.
set -uo pipefail

MSG_FILE="${1:?commit-msg hook called without a message file}"
GIT_DIR="$(git rev-parse --git-dir)"

# Merge commits: git writes the message itself.
[[ -e "$GIT_DIR/MERGE_HEAD" ]] && exit 0
# Cherry-pick / revert sequencer in flight: same reasoning.
[[ -e "$GIT_DIR/sequencer" ]] && exit 0
# fixup!/squash! get folded into their target on rebase.
grep -qE '^(fixup|squash)! ' "$MSG_FILE" && exit 0

missing=()
grep -qE '^Signed-off-by: .+ <.+@.+>' "$MSG_FILE" || missing+=("Signed-off-by")

# Assisted-by must be AGENT_NAME:MODEL_VERSION, optionally followed by
# specialised tools, or the local "none" for an unaided human commit.
# Neither field may be empty and neither may contain whitespace, which
# is what catches a bare "Assisted-by: Claude" or a stray "Assisted-by:".
assisted_re='^Assisted-by: ([^[:space:]:]+:[^[:space:]]+([[:space:]]+[^[:space:]]+)*|none)[[:space:]]*$'
if grep -qE '^Assisted-by:' "$MSG_FILE"; then
	if ! grep -qE "$assisted_re" "$MSG_FILE"; then
		echo "commit-msg: rejected -- malformed Assisted-by trailer." >&2
		echo "  Found: $(grep -m1 '^Assisted-by:' "$MSG_FILE")" >&2
		echo >&2
		echo "  kernel.org format is AGENT_NAME:MODEL_VERSION [tool ...]" >&2
		echo "      Assisted-by: Claude-Code:claude-opus-5" >&2
		echo "      Assisted-by: Claude:claude-3-opus coccinelle sparse" >&2
		echo "  Do not list basic tools (git, gcc, make, editors)." >&2
		echo "  For an unaided human commit use: Assisted-by: none" >&2
		exit 1
	fi
else
	missing+=("Assisted-by")
fi

# An AI must never sign off; only the human does.
if grep -qiE '^Signed-off-by: .*(claude|hermes|openclaw|gpt|copilot|agent)' "$MSG_FILE"; then
	echo "commit-msg: rejected -- an AI must not carry Signed-off-by." >&2
	echo "  Only the human signs off. The agent goes in Assisted-by." >&2
	exit 1
fi

# The trailer the system prompt default wants, which local policy forbids.
if grep -qiE '^Co-Authored-By: .*(claude|anthropic)' "$MSG_FILE"; then
	echo "commit-msg: rejected -- Co-Authored-By is disabled in this repo." >&2
	echo "  Use Assisted-by instead. See ~/.claude/CLAUDE.md." >&2
	exit 1
fi

if (( ${#missing[@]} )); then
	echo "commit-msg: rejected -- missing required trailer(s): ${missing[*]}" >&2
	echo >&2
	echo "  Every commit here must record who made it. Add to the message:" >&2
	echo >&2
	echo "      Signed-off-by: Lance <Gero3977@gmail.com>" >&2
	echo "      Assisted-by: <Harness>:<model>" >&2
	echo >&2
	echo "  Assisted-by is AGENT_NAME:MODEL_VERSION and must name the model" >&2
	echo "  ACTUALLY running when the commit was written -- never a copied" >&2
	echo "  or stale id. Examples:" >&2
	echo "      Assisted-by: Claude-Code:claude-opus-5" >&2
	echo "      Assisted-by: Hermes-Agent:deepseek/deepseek-v4-flash" >&2
	echo >&2
	echo "  A human committing unaided may use:" >&2
	echo "      Assisted-by: none" >&2
	echo >&2
	echo "  Requiring Assisted-by on every commit is a local rule, stricter" >&2
	echo "  than kernel.org, so four committers sharing one git identity can" >&2
	echo "  be told apart. See the comments at the top of this hook." >&2
	exit 1
fi

exit 0
