# joan audio + voice-call config fragment
#
# Merge into a joan kernel config with:
#   scripts/kconfig/merge_config.sh .config configs/joan-audio-voice.config
#
# Every symbol here was found missing from docs/master-47041183b.config while
# bringing up call audio on 2026-08-23.  Two of them are not optional extras:
# without them the machine driver never resolves its dai-links and NO sound
# card registers at all.

# --- ADSP -------------------------------------------------------------------
# Boots the ADSP.  Without it every audio module loads and nothing works:
# no remoteproc entries, no APR devices, no sound card.  The absence looks
# exactly like a broken audio subsystem.
CONFIG_QCOM_Q6V5_PAS=m

# --- codecs referenced by joan's sound node ---------------------------------
# A sound card is all-or-nothing: one unresolvable codec dai leaves the whole
# card in deferred probe forever, so a missing speaker-amp driver also takes
# down the unrelated SLIM/WCD link (the earpiece and the call mic).
#
#   tert-mi2s-dai-link -> &speaker_amp  (nxp,tfa9872)
#   quat-mi2s-dai-link -> &es9218p      (ess,es9218p)
#   slim-playback-dai-link -> &wcd9340  (slim217,250)
CONFIG_SND_SOC_TFA989X=m
CONFIG_SND_SOC_ES9218P=m
CONFIG_SND_SOC_WCD934X=m

# --- SLIMbus: carries the WCD codec ----------------------------------------
CONFIG_SLIMBUS=m
CONFIG_SLIM_QCOM_NGD_CTRL=m

# --- Core Voice Driver: circuit-switched and VoLTE call audio ---------------
# MVM/CVS/CVP on the ADSP.  Not needed for playback or capture.
CONFIG_SND_SOC_QDSP6_VOICE=m
