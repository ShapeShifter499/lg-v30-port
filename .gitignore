out/
initramfs/bin/
*.apk
backups/

# Firmware distribution boundary:
# - A530 PM4/PFP comes from postmarketOS firmware-qcom-adreno-a530 and is not
#   vendored here.
# - LG A540 GPMU/ZAP is owner-extracted, proprietary, and local-only.
# Keep all local copies available for fail-closed image construction while
# excluding them from the public Git tree.
firmware/lg-vendor/
firmware/zap/
firmware/wcn/
initramfs/root/lib/firmware/qcom/a530_*.fw
initramfs/root/lib/firmware/qcom/a540_*

# Local firmware RE workspace (binaries stay out of git; scripts only)
fw/adsp/
fw/adsp-merged.elf
fw/adsp-proj.gpr
fw/adsp-proj.rep/
