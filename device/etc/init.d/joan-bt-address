#!/sbin/openrc-run

description="Give joan's Bluetooth controller a public BD address"
command=/usr/local/sbin/joan-bt-address

depend() {
	before bluetooth
	# Soft ordering only. "need dev" looks right but there is no "dev"
	# service on postmarketOS (it uses devfs/udev), and an unsatisfiable
	# need makes OpenRC refuse to start this service at all -- silently,
	# since it then never appears in rc-status either. The script waits
	# for hci0 on its own, so ordering is a convenience, not a
	# requirement.
	after udev modules
}

start() {
	ebegin "Configuring the Bluetooth public address"
	"$command"
	eend $?
}

stop() {
	# The address lives in the controller until it is powered down;
	# there is nothing to undo.
	return 0
}
