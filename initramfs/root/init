#!/bin/busybox sh
# Bring-up initramfs for LG V30 (joan) boots (mainline or downstream).
# Goal: enumerate as a USB network + ACM serial gadget, then offer a
# telnet root shell. No storage is touched.

/bin/busybox --install -s /bin
export PATH=/bin

mount -t devtmpfs dev /dev
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t configfs configfs /sys/kernel/config
mkdir -p /tmp

# Kill the APSS watchdog at the register level (busybox devmem proved
# absent; wdkill is our own static tool). Logs initial EN/BARK/BITE
# state, disables, then keeps petting in case something re-arms it.
/bin/wdkill > /tmp/wdt.log 2>&1 &

# --- USB gadget: network (ECM, else RNDIS/NCM) + ACM serial ---
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G
echo 0x18d1 > $G/idVendor     # Google
echo 0x4e26 > $G/idProduct
mkdir -p $G/strings/0x409
echo joan-mainline-0001 > $G/strings/0x409/serialnumber
echo LG > $G/strings/0x409/manufacturer
echo "V30 mainline bring-up" > $G/strings/0x409/product

mkdir -p $G/configs/c.1/strings/0x409
echo "bringup" > $G/configs/c.1/strings/0x409/configuration
echo 500 > $G/configs/c.1/MaxPower

NET=""
for f in ecm rndis ncm; do
    if mkdir $G/functions/$f.usb0 2>/dev/null; then
        ln -s $G/functions/$f.usb0 $G/configs/c.1/ && NET=$f && break
    fi
done
mkdir $G/functions/acm.GS0 2>/dev/null && ln -s $G/functions/acm.GS0 $G/configs/c.1/ 2>/dev/null

# Wait up to 300s for a UDC to probe (deferred probes get unlimited
# time once the watchdog is dead), then bind.
n=0
while [ $n -lt 300 ]; do
    UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
    [ -n "$UDC" ] && break
    sleep 1; n=$((n+1))
done
[ -n "$UDC" ] && echo "$UDC" > $G/UDC

# --- network + shells ---
ip link set lo up
# device-side netdev name differs per function (usb0/rndis0/ncm0):
# bring up the first non-loopback interface.
for IF in $(ls /sys/class/net | grep -v '^lo$'); do
    ip link set "$IF" up 2>/dev/null
    ip addr add 172.16.42.1/24 dev "$IF" 2>/dev/null && break
done

telnetd -l /bin/sh

# Serial shell on the ACM function (setsid+exec: works where getty
# can't grab a controlling tty), respawned forever.
(while :; do
    setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1' 2>/dev/null
    sleep 2
done) &

# --- Stable diagnostic servers. Do NOT re-bind the gadget: unbinding
# --- the UDC re-enumerates ACM+network and breaks host-side capture.
# --- Instead serve fresh dumps over the network on fixed ports; each
# --- connection re-dumps and the loop re-listens for the whole boot.
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null

# Port 9600: dmesg on demand (most important; served first, never
# blocked by a potentially-hanging debugfs clock read).
(while :; do dmesg > /tmp/dmesg.txt 2>&1; nc -l -p 9600 < /tmp/dmesg.txt; done) &

# Port 9601: fuller diag (clk/regulator/interrupts). Reading
# clk_summary can hang if a display clock is wedged, so this is a
# separate server that must never block the dmesg one above.
(while :; do
    {
        echo "===VERSION===";    cat /proc/version
        echo "===CMDLINE===";    cat /proc/cmdline
        echo "===GADGETNET===";  echo "$NET"; ip addr
        echo "===INTERRUPTS==="; cat /proc/interrupts
        echo "===CLK===";        cat /sys/kernel/debug/clk/clk_summary
        echo "===REGULATOR===";  cat /sys/kernel/debug/regulator/regulator_summary
        echo "===END==="
    } > /tmp/diag.txt 2>&1
    nc -l -p 9601 < /tmp/diag.txt
done) &

# Self-recover: reboot after 15 min unless /keep is touched (via a
# live shell), so a dead-end boot never needs the power button.
n=0
while :; do
    sleep 60; n=$((n+1))
    [ -e /keep ] && continue
    [ $n -ge 15 ] && echo b > /proc/sysrq-trigger
done
